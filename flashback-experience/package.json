{
  "name": "flashback-experience",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=20.12" },
  "scripts": {
    "dev": "concurrently -k -n api,web -c gray,cyan \"npm:dev:server\" \"npm:dev:web\"",
